<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb" xmlns:xs="http://www.w3.org/2001/XMLSchema"
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://jakarta.ee/xml/ns/jaxb http://java.sun.com/xml/ns/jaxb/bindingschema_2_0.xsd"
               version="3.0"
               jaxb:extensionBindingPrefixes="xjc">

	<jaxb:globalBindings generateElementProperty="false">
        <xjc:javaType name="org.joda.time.LocalDateTime" xmlType="xs:dateTime" adapter="no.nav.brevogarkiv.adapters.LocalDateTimeAdapter" />
        <xjc:javaType name="org.joda.time.LocalDate" xmlType="xs:date" adapter="no.nav.brevogarkiv.adapters.LocalDateAdapter" />
	</jaxb:globalBindings>

</jaxb:bindings>
