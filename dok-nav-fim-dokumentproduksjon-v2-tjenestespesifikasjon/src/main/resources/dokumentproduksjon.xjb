<jaxws:bindings
		xmlns:jaxws="https://jakarta.ee/xml/ns/jaxws"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="https://jakarta.ee/xml/ns/jaxws https://jakarta.ee/xml/ns/jaxws/wsdl_customizationschema_3_0.xsd"
		version="3.0"
		xmlns:xsd="http://www.w3.org/2001/XMLSchema"
		xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
		wsdlLocation="./wsdl/no/nav/tjeneste/virksomhet/dokumentproduksjon/v2/dokumentproduksjon.wsdl">
	<jaxws:bindings node="wsdl:definitions/wsdl:portType[@name='Dokumentproduksjon_v2']">
		<jaxws:package name="no.nav.tjeneste.virksomhet.dokumentproduksjon.v2.binding"/>
	</jaxws:bindings>
</jaxws:bindings>