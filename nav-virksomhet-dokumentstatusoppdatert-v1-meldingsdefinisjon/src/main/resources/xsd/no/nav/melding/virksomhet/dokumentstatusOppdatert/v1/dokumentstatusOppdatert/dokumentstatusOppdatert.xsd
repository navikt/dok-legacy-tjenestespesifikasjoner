<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://nav.no/melding/virksomhet/dokumentstatusOppdatert/v1/informasjon" version="1.0.0" xmlns:informasjon="http://nav.no/melding/virksomhet/dokumentstatusOppdatert/v1/informasjon">
  <xsd:element name="dokumentstatusOppdatert" type="informasjon:DokumentstatusOppdatert"/>
  <xsd:complexType name="DokumentstatusOppdatert">
    <xsd:sequence>
      <xsd:element name="journalpostId" type="informasjon:Identifikator"/>
      <xsd:element name="dokumentId" type="informasjon:Identifikator"/>
      <xsd:element name="status" type="informasjon:Statuser"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="Identifikator">
    <xsd:restriction base="xsd:string"/>
  </xsd:simpleType>
  <xsd:complexType name="Statuser">
    <xsd:simpleContent>
      <xsd:extension base="informasjon:Kodeverdi">
        <xsd:attribute name="kodeverksRef" type="xsd:anyURI"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="Kodeverdi">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="kodeRef" type="xsd:anyURI"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
</xsd:schema>