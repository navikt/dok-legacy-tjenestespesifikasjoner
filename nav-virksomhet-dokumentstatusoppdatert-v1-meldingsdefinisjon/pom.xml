<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>dok-legacy-tjenestespesifikasjoner</artifactId>
        <groupId>no.nav.dok</groupId>
        <version>${revision}</version>
    </parent>

    <groupId>no.nav.meldinger.virksomhet</groupId>
    <artifactId>nav-virksomhet-dokumentstatusoppdatert-v1-meldingsdefinisjon</artifactId>
    <version>${revision}</version>

    <properties>
        <maven-jaxb2-plugin.version>0.15.2</maven-jaxb2-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jvnet.jaxb2.maven2</groupId>
                <artifactId>maven-jaxb2-plugin</artifactId>
                <version>${maven-jaxb2-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-jaxb-dokumenstatusoppdatert</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <schemaDirectory>src/main/resources/xsd/no/nav/melding/virksomhet/dokumentstatusOppdatert/v1/dokumentstatusOppdatert</schemaDirectory>
                            <generateDirectory>${project.basedir}/target</generateDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>