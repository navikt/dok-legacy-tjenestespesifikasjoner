<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://nav.no/melding/virksomhet/dokdistfordeling"
		   xmlns:dokdistfordeling="http://nav.no/melding/virksomhet/dokdistfordeling">

	<xs:element name="distribuerTilKanal" type="dokdistfordeling:DistribuerTilKanal"/>

	<xs:complexType name="DistribuerTilKanal">
		<xs:sequence>
			<xs:element name="forsendelseId" type="dokdistfordeling:nonEmptyStringNoBlanks">
				<xs:annotation>
					<xs:documentation>ForsendelseId. Kan ikke inneholde blank eller
						space.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="nonEmptyStringNoBlanks">
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>