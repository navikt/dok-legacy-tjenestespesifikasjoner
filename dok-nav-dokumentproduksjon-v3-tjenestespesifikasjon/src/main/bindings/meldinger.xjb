<jaxb:bindings
        xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
		xmlns:xsd="http://www.w3.org/2001/XMLSchema"
		version="3.0">
	<jaxb:bindings schemaLocation="../resources/wsdl/no/nav/tjeneste/virksomhet/dokumentproduksjon/v3/meldinger/meldinger.xsd">
		<jaxb:bindings node="/xsd:schema/xsd:complexType[@name='ProduserIkkeredigerbartDokumentRequest']/xsd:sequence/xsd:any">
			<jaxb:property name="brevdata"/>
		</jaxb:bindings>
		<jaxb:bindings node="/xsd:schema/xsd:complexType[@name='ProduserRedigerbartDokumentRequest']/xsd:sequence/xsd:any">
			<jaxb:property name="brevdata"/>
		</jaxb:bindings>
		<jaxb:bindings node="/xsd:schema/xsd:complexType[@name='ProduserDokumentutkastRequest']/xsd:sequence/xsd:any">
			<jaxb:property name="brevdata"/>
		</jaxb:bindings>
		<jaxb:bindings node="/xsd:schema/xsd:complexType[@name='ProduserIkkeredigerbartVedleggRequest']/xsd:sequence/xsd:any">
			<jaxb:property name="brevdata"/>
		</jaxb:bindings>
	</jaxb:bindings>
</jaxb:bindings>