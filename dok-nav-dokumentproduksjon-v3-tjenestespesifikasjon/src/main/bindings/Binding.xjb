<jaxws:bindings
		xmlns:jaxws="https://jakarta.ee/xml/ns/jaxws/"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="https://jakarta.ee/xml/ns/jaxws https://jakarta.ee/xml/ns/jaxws/wsdl_customizationschema_3_0.xsd"
		version="3.0"
		xmlns:xsd="http://www.w3.org/2001/XMLSchema"
		xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
	<jaxws:bindings node="wsdl:definitions/wsdl:service[@name='Dokumentproduksjon_v3']">
		<jaxws:class name="DokumentproduksjonV3_Service"/>
	</jaxws:bindings>
</jaxws:bindings>